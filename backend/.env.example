# Обязательные секреты: не использовать значения из примеров для реального запуска.
JWT_SECRET_KEY=
TELEGRAM_BOT_TOKEN=

# JWT: срок access в минутах, refresh в днях.
JWT_ACCESS_TTL_MINUTES=10
JWT_REFRESH_TTL_DAYS=7
# JWT_COOKIE_SECURE=false только для локального HTTP.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# Telegram: проверка возраста включена по умолчанию.
TELEGRAM_CHECK_INIT_DATA_AGE=true
TELEGRAM_INIT_DATA_TTL_SECONDS=300
TELEGRAM_CLOCK_SKEW_SECONDS=30

# SQLite: относительный путь отсчитывается от каталога backend.
DATABASE_NAME=freefood.db

# Лимит активных сессий на пользователя и очистка завершённых сессий.
MAX_ACTIVE_SESSIONS=5
SESSION_CLEANUP_ENABLED=true
SESSION_CLEANUP_INTERVAL_HOURS=24
